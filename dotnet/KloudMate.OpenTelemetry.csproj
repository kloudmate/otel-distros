<Project Sdk="Microsoft.NET.Sdk">
  <!--
    KloudMate plugin for OpenTelemetry .NET automatic instrumentation (OTEL_DOTNET_AUTO_PLUGINS).
    net8.0: the plugin API (OpenTelemetry.AutoInstrumentation.PluginApi) targets net8.0 and net462; Linux runs
    net8.0 and later.
    Every OpenTelemetry package is compile-only: upstream loads its own copies, and a plugin must reference
    exactly the versions upstream bundles (PluginApi 1.19.1 and OpenTelemetry 1.20.1 for
    opentelemetry-dotnet-instrumentation 1.19.1).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>KloudMate.OpenTelemetry</AssemblyName>
    <RootNamespace>KloudMate.OpenTelemetry</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.2.0</Version>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <PathMap>$(MSBuildProjectDirectory)=/src</PathMap>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Company>KloudMate</Company>
    <Product>KloudMate OpenTelemetry .NET distribution</Product>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="OpenTelemetry.AutoInstrumentation.PluginApi" Version="1.19.1" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="OpenTelemetry" Version="1.20.1" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="smoke/**;test/**" />
  </ItemGroup>
</Project>
